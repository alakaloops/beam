# ==========================================
# Beam — Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# Solana Network (devnet | mainnet-beta)
SOLANA_NETWORK=devnet

# Solana RPC Configuration (Priority: SOLANA_RPC_URL -> HELIUS_API_KEY -> Network default)
# Devnet default: https://api.devnet.solana.com
# Mainnet default: https://api.mainnet-beta.solana.com
# Recommended for production: Helius, Triton, QuickNode, or Alchemy
# HELIUS_API_KEY=your_helius_api_key_here
# SOLANA_RPC_URL=https://api.devnet.solana.com
